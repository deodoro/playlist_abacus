{
    "name": "Playlist Abacus",
    "version": "0.1.0",
    "private": true,
    "homepage": "/playlist_abacus",
    "dependencies": {
        "@geist-ui/react": "^2.2.5",
        "axios": "^1.7.9",
        "cra-template": "1.2.0",
        "prop-types": "^15.8.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-icons": "^5.4.0",
        "react-router-dom": "^7.1.1",
        "serve": "^14.2.4"
    },
    "scripts": {
        "build:css": "npx tailwindcss -i ./src/index.css -o ./src/index.css --watch",
        "start": "PORT=8888 react-scripts start",
        "build": "env-cmd -f .env.production react-scripts build",
        "test": "react-scripts test",
        "eject": "react-scripts eject"
    },
    "eslintConfig": {
        "extends": [
            "react-app",
            "react-app/jest"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
        "autoprefixer": "^10.4.20",
        "env-cmd": "^10.1.0",
        "postcss": "^8.4.49",
        "react-scripts": "^5.0.1",
        "tailwindcss": "^3.4.17"
    }
}
